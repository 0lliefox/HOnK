# Copy to slurm/hpc.env and fill in. hpc.env is git-ignored (contains host/paths).
# Compute host (reached via the jump host below):
HPC_HOST="b9063849@comet.hpc.ncl.ac.uk"
# Jump/gateway host (omit if you reach the compute host directly):
HPC_PROXY_JUMP="b9063849@unix.ncl.ac.uk"
# Absolute path to the HOnK checkout on the cluster (CONFIRM THIS PATH):
HPC_REMOTE_DIR="/nobackup/proj/comet_honkstar/HOnK"
# slurm array job id to wait on (set after sbatch), or leave blank and use --no-wait
HPC_JOBID=""
# Private key for non-interactive auth (generated as ~/.ssh/honk_hpc):
HPC_SSH_KEY="$HOME/.ssh/honk_hpc"
# optional: squeue poll interval in seconds
POLL_SECONDS="120"
