  <rdf:Description rdf:about="http://honk.org/canon#causes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>causes</rdfs:label>
    <rdfs:comment>one event or state brings about another</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#LocationNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>location noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a location noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#ProcessNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>process noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a process noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#mannerOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>manner of</rdfs:label>
    <rdfs:comment>a specific way or manner of performing an action</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Determiner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>determiner</rdfs:label>
    <rdfs:comment>part-of-speech category: a determiner</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#CognitionVerb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>cognition verb</rdfs:label>
    <rdfs:comment>part-of-speech category: a cognition verb</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#symbolOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>symbol of</rdfs:label>
    <rdfs:comment>serves as a symbol or sign standing for something</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#QuantityNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>quantity noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a quantity noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#neqTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>neq to</rdfs:label>
    <rdfs:comment>inequality or opposition; the two differ or are opposite in sense</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#hasA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>has a</rdfs:label>
    <rdfs:comment>possession; the subject has this as a component or attribute</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#hasPrerequisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>has prerequisite</rdfs:label>
    <rdfs:comment>a precondition that must hold before something occurs</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>concept</rdfs:label>
    <rdfs:comment>part-of-speech category: a concept</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Symbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>symbol</rdfs:label>
    <rdfs:comment>part-of-speech category: a symbol</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Article">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>article</rdfs:label>
    <rdfs:comment>part-of-speech category: a article</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#ConsumptionVerb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>consumption verb</rdfs:label>
    <rdfs:comment>part-of-speech category: a consumption verb</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#BodyNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>body noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a body noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>product</rdfs:label>
    <rdfs:comment>the output or product that results from something</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#eq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>eq</rdfs:label>
    <rdfs:comment>equivalence; the two terms denote the same thing or sense</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#relatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>related to</rdfs:label>
    <rdfs:comment>a general, unspecified association between two terms</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#instanceOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>instance of</rdfs:label>
    <rdfs:comment>an individual instance belonging to a class</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#AdverbialPhrase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>adverbial phrase</rdfs:label>
    <rdfs:comment>part-of-speech category: a adverbial phrase</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#isA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>is a</rdfs:label>
    <rdfs:comment>a type-of relationship; the subject is a kind of the object</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#compositeFormWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>composite form with</rdfs:label>
    <rdfs:comment>combines with another element to form a compound term</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#PersonNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>person noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a person noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#TimeNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>time noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a time noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#hasContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>has context</rdfs:label>
    <rdfs:comment>the domain, register or context in which a term is used</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#CombiningForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>combining form</rdfs:label>
    <rdfs:comment>part-of-speech category: a combining form</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Suffix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>suffix</rdfs:label>
    <rdfs:comment>part-of-speech category: a suffix</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Punctuation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>punctuation</rdfs:label>
    <rdfs:comment>part-of-speech category: a punctuation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#PhenomenonNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>phenomenon noun</rdfs:label>
    <rdfs:comment>part-of-speech category: a phenomenon noun</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://honk.org/canon#Idiom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>idiom</rdfs:label>
    <rdfs:comment>part-of-speech category: a idiom</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
